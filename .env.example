# Kopiera den här filen till .env.local för lokal körning.
# På Vercel läggs värdena in under Settings, Environment Variables.

# Offertformuläret.
#   off      stängt (standard)
#   preview  formuläret fungerar men ingenting skickas eller sparas. Bara för test, inte publikt.
#   live     förfrågningar skickas som mejl. Kräver att operator är satt i lib/site.ts och de tre värdena nedan.
REQUESTS_MODE=off

# Mejltjänst (Resend). Avsändaren onboarding@resend.dev når bara kontots egen adress.
# Verifiera en domän i Resend för att skicka från en egen adress.
RESEND_API_KEY=
REQUEST_TO_EMAIL=
REQUEST_FROM_EMAIL=

# Valfri nyckel för att signera tidsstämpeln i formulären. Saknas den används RESEND_API_KEY.
REQUEST_SIGNING_SECRET=

# Sajten är stängd för sökmotorer tills detta är true. Kräver operator och contactEmail i lib/site.ts.
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=https://brfforvaltare.se
